# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Settings
CORS_ORIGIN=http://localhost:8080,https://scratch.mit.edu

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/scratch_integrations
REDIS_URL=redis://localhost:6379

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-...

# Hugging Face Configuration
HUGGINGFACE_API_KEY=hf_...

# Ollama/Local Models
OLLAMA_API_URL=http://localhost:11434
LMSTUDIO_API_URL=http://localhost:1234/v1

# n8n Configuration
N8N_API_URL=https://n8n.example.com
N8N_API_KEY=n8n_api_key_...

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal Configuration
PAYPAL_CLIENT_ID=...
PAYPAL_SECRET=...
PAYPAL_MODE=sandbox  # or 'live'

# Blockchain Configuration
BLOCKCHAIN_NETWORK=polygon  # ethereum, polygon, solana
BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
BLOCKCHAIN_PRIVATE_KEY=...  # For signing transactions
TOKEN_CONTRACT_ADDRESS=0x...

# Security
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=32-byte-hex-string

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FILE=./logs/app.log

# Features Flags
ENABLE_LLM=true
ENABLE_N8N=true
ENABLE_CRYPTO=true
ENABLE_PAYMENTS=true

# Costs & Limits
LLM_DAILY_LIMIT_FREE=10
LLM_DAILY_LIMIT_PREMIUM=unlimited
LLM_COST_PER_REQUEST=0.01  # USD

# Token Economics
SCRATCH_TOKEN_PRICE_USD=0.10
REWARD_MULTIPLIER=1.0
NFT_MINT_COST_SCRATCH=100

# Subscription Plans
PLAN_PREMIUM_PRICE_USD=4.99
PLAN_PREMIUM_PRICE_MONTHLY=true
PLAN_PRO_PRICE_USD=9.99
PLAN_PRO_PRICE_MONTHLY=true
